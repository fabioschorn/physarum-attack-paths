# Operator key pair — used by the Dev Lead to SSH into any maze host.
resource "aws_key_pair" "operator" {
  key_name   = "physarum-pf1-operator"
  public_key = file(var.ssh_public_key_path)
  tags       = { Name = "physarum-pf1-operator" }
}

# Propagation key pair — generated by Terraform, used exclusively by the
# physarum organism on Host A to SCP itself to discovered corridor hosts.
#
# Security note: the private key is embedded in Host A's user_data (visible
# in EC2 instance metadata during launch). Acceptable for a lab destroyed
# immediately after evidence collection. Do not reuse this key elsewhere.
resource "tls_private_key" "propagation" {
  algorithm = "ED25519"
}
