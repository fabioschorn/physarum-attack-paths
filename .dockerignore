# Build artifacts
target/
**/target/

# Lock files from sub-workspaces (not needed in build context)
crates/physarum-ebpf-observer-ebpf/Cargo.lock
crates/physarum-packet-observer-ebpf/Cargo.lock
xtask/Cargo.lock

# External clones — never committed, not needed for Docker build
RustScan/

# Lab workspaces and runtime volumes — not needed to compile Rust binaries
examples/
docker/*-volume/
docker/lineage/

# VCS
.git/

# CI / tooling
.github/
.claude/

# Local environment
.env
*.env

# Editor
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Terraform state and secrets — never include in images
examples/aws-lab/.keys/
examples/aws-lab/terraform/.terraform/
examples/aws-lab/terraform/terraform.tfstate
examples/aws-lab/terraform/terraform.tfstate.backup
examples/aws-lab/terraform/*.tfplan
