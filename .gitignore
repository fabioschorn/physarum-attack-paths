# ── macOS ────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── Windows ──────────────────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Rust build output (generated — never commit) ──────────────────────────────
target/

# rustfmt backup files (created with --backup flag)
**/*.rs.bk

# Windows debug symbol files (generated during cross-compilation)
*.pdb

# ── Distribuição local (gerado por Utilities/dist-local.sh) ──────────────────
dist/
*.tar.gz
*.zip

# ── Editors — JetBrains ───────────────────────────────────────────────────────
.idea/

# ── Editors — VS Code ─────────────────────────────────────────────────────────
# settings.json e launch.json são configurações pessoais, não do projeto.
# extensions.json (recomendações de extensões) PODE ser commitado.
.vscode/settings.json
.vscode/launch.json

# ── Editors — Vim / Emacs / genéricos ────────────────────────────────────────
*.swp
*.swo
*~

# ── Ambiente ──────────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── Temporários locais (gerados por scripts internos, nunca commitados) ────────
tmp/

# ── AWS lab SSH keys (never commit private or public key material) ─────────────
examples/aws-lab/.keys/
examples/aws-lab/*.pem
examples/aws-lab/*_rsa
examples/aws-lab/*_ed25519
examples/aws-lab/*_ecdsa

# ── Ansible local inventory and live outputs (contain live IPs) ───────────────
examples/aws-lab/ansible/*.local.ini
examples/aws-lab/ansible/*.local.json
examples/aws-lab/ansible/terraform-outputs.local.json

# ── Terraform state and credentials (never commit) ────────────────────────────
examples/aws-lab/terraform/terraform.tfstate
examples/aws-lab/terraform/terraform.tfstate.backup
examples/aws-lab/terraform/.terraform/
examples/aws-lab/terraform/*.tfvars

# ── TLA+ toolchain binaries (download locally to run TLC) ────────────────────
formal/tla/tla2tools.jar