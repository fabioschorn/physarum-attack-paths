# PF-4 Real LLM Lab — environment variables template
#
# Copy this file to .env.local (gitignored) and fill in your values.
# NEVER commit .env.local or any file containing real credentials.
#
# Usage:
#   cp .env.example .env.local
#   # edit .env.local with your values
#   source .env.local && ../../../../Utilities/docker-lab.sh

# OpenAI-compatible endpoint (required for PF-4 real LLM mode)
# Examples:
#   https://api.openai.com         (OpenAI)
#   http://host.docker.internal:11434   (local Ollama)
PHYSARUM_LLM_ENDPOINT=

# Model name sent to the endpoint (optional — defaults to gpt-4o-mini)
PHYSARUM_LLM_MODEL=gpt-4o-mini

# API key for the LLM endpoint (required when PHYSARUM_LLM_ENDPOINT is set)
# Never appears in lineage JSON — injected via environment only.
LLM_API_KEY=
